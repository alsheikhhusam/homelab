      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (namespace, workload) (max by (namespace,pod,workload) (label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.*)\") * on(namespace,replicaset) group_left(workload) max by (namespace,replicaset,workload) (label_replace(kube_replicaset_owner{owner_kind=\"Deployment\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\")) or label_replace(kube_pod_owner{owner_kind=\"StatefulSet\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\"))), \"name\", \"/\", \"namespace\", \"workload\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(1000 * sum by (namespace, workload) (max by (namespace,pod,container) (kube_pod_container_resource_requests{resource=\"cpu\"}) * on(namespace,pod) group_left(workload) max by (namespace,pod,workload) (label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.*)\") * on(namespace,replicaset) group_left(workload) max by (namespace,replicaset,workload) (label_replace(kube_replicaset_owner{owner_kind=\"Deployment\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\")) or label_replace(kube_pod_owner{owner_kind=\"StatefulSet\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\"))), \"name\", \"/\", \"namespace\", \"workload\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(1000 * sum by (namespace, workload) (max by (namespace,pod,container) (kube_pod_container_resource_limits{resource=\"cpu\"}) * on(namespace,pod) group_left(workload) max by (namespace,pod,workload) (label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.*)\") * on(namespace,replicaset) group_left(workload) max by (namespace,replicaset,workload) (label_replace(kube_replicaset_owner{owner_kind=\"Deployment\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\")) or label_replace(kube_pod_owner{owner_kind=\"StatefulSet\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\"))), \"name\", \"/\", \"namespace\", \"workload\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (namespace, workload) (max by (namespace,pod,container) (kube_pod_container_resource_requests{resource=\"memory\"}) * on(namespace,pod) group_left(workload) max by (namespace,pod,workload) (label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.*)\") * on(namespace,replicaset) group_left(workload) max by (namespace,replicaset,workload) (label_replace(kube_replicaset_owner{owner_kind=\"Deployment\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\")) or label_replace(kube_pod_owner{owner_kind=\"StatefulSet\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\"))), \"name\", \"/\", \"namespace\", \"workload\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (namespace, workload) (max by (namespace,pod,container) (kube_pod_container_resource_limits{resource=\"memory\"}) * on(namespace,pod) group_left(workload) max by (namespace,pod,workload) (label_replace(kube_pod_owner{owner_kind=\"ReplicaSet\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.*)\") * on(namespace,replicaset) group_left(workload) max by (namespace,replicaset,workload) (label_replace(kube_replicaset_owner{owner_kind=\"Deployment\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\")) or label_replace(kube_pod_owner{owner_kind=\"StatefulSet\"}, \"workload\", \"$1\", \"owner_name\", \"(.*)\"))), \"name\", \"/\", \"namespace\", \"workload\")",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
